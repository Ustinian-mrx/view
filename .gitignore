# Flutter / Dart generated files
/.dart_tool/
/.packages
/.flutter-plugins
/.flutter-plugins-dependencies
/build/
/coverage/

# Android / Gradle generated files
**/.gradle/
**/.kotlin/
**/build/
**/.cxx/
**/.externalNativeBuild/
*.apk
*.aab
*.apks

# Machine-local SDK and signing configuration
**/local.properties
android/key.properties
*.jks
*.keystore

# IDE and operating-system files
/.idea/
/.vscode/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# Logs, temporary files and crash dumps
*.log
*.tmp
*.temp
*.bak
*.swp
*.hprof
hs_err_pid*

# Keep source-controlled NCNN runtime and model assets.
!android/app/src/main/jniLibs/arm64-v8a/libncnn.so
!assets/models/*.bin
